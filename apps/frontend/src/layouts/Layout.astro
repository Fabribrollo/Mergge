---
import '../styles/mergge.css'
import '../styles/landing.css'
// Fuentes servidas desde el propio sitio (antes venían de Google Fonts):
// una conexión menos antes de pintar el texto. Solo el alfabeto latino
// (incluye ñ y tildes) y solo los pesos que usamos.
import '@fontsource/anton/latin-400.css'
import '@fontsource/poppins/latin-400.css'
import '@fontsource/poppins/latin-500.css'
import '@fontsource/poppins/latin-600.css'
import '@fontsource/poppins/latin-700.css'
// Anton es la del título grande: la pedimos apenas arranca la página.
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url'
import { SITIO } from '../datos/sitio.js'
import Medicion from '../components/Medicion.astro'

interface Props {
  title: string
  description?: string
  /** true en páginas que no tienen que aparecer en Google (ej. /form) */
  noindex?: boolean
  /** Datos estructurados JSON-LD de la página, si tiene */
  schema?: object
  /** Imagen para compartir (ruta dentro de public) */
  imagen?: string
}

const { title, description = SITIO.descripcion, noindex = false, schema, imagen = SITIO.imagenOg } = Astro.props

// Dirección oficial de esta página y de la imagen para compartir.
const canonical = new URL(Astro.url.pathname, Astro.site)
const imagenUrl = new URL(imagen, Astro.site)
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#3130E3" />

    <!-- Favicons: el .ico en la raíz es el que buscan muchos lectores sin mirar el HTML -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/marca/favicon-32.png" />
    <!-- Google pide un ícono cuadrado múltiplo de 48 px (48, 96, 192…): el .ico de 48 y este de 192 -->
    <link rel="icon" type="image/png" sizes="192x192" href="/marca/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/marca/favicon-512.png" />
    <link rel="apple-touch-icon" href="/marca/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />

    <!-- Vista previa al compartir (WhatsApp, redes, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mergge Studio, diseño y desarrollo web en Argentina" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <Medicion />

    <!-- Antes de pintar nada: si la pantalla de carga ya se vio en esta
         sesión, o si es un celular (ahí no la mostramos: Google mide la
         velocidad en celular y la espera pesaba ~4 s), la marcamos para que
         el CSS la oculte y no "parpadee". -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('mg-precarga') || window.matchMedia('(max-width: 767px)').matches) {
          document.documentElement.dataset.precarga = 'vista'
          window.__merggeListo = true
        }
      } catch (e) {}
    </script>

    <!-- Sin JavaScript: todo lo que Motion arranca oculto se muestra igual. -->
    <noscript>
      <style>
        .mg-anim { opacity: 1 !important; transform: none !important; clip-path: none !important; }
        #mg-precarga { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
    <div class="mg-grano" aria-hidden="true"></div>

    <script>
      // Scroll suave con Lenis, solo en compu y si no pidieron menos movimiento.
      // En celular dejamos el scroll nativo: ya es suave y no hay que pelearlo.
      import Lenis from 'lenis'

      const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const tactil = window.matchMedia('(pointer: coarse)').matches
      let lenis: Lenis | null = null

      if (!menosMovimiento && !tactil) {
        lenis = new Lenis({ duration: 1.1, smoothWheel: true })
        const loop = (t: number) => {
          lenis!.raf(t)
          requestAnimationFrame(loop)
        }
        requestAnimationFrame(loop)
        // La pantalla de carga frena el scroll hasta que termina.
        if (!(window as any).__merggeListo) {
          lenis.stop()
          window.addEventListener('mergge:listo', () => lenis!.start(), { once: true })
        }
      }

      // Links del menú (#seccion): en vez de pegar la sección al borde de arriba,
      // la dejamos centrada en la pantalla. Si la sección es más alta que la
      // pantalla, vamos a su comienzo más el desplazamiento que diga data-ancla
      // (sirve para saltear los degradés de arriba, por ejemplo en Contacto).
      function destino(seccion: HTMLElement) {
        const r = seccion.getBoundingClientRect()
        const arriba = r.top + window.scrollY
        const alto = window.innerHeight
        if (r.height <= alto) return arriba - (alto - r.height) / 2
        return arriba + Number(seccion.dataset.ancla || 0)
      }

      document.addEventListener(
        'click',
        (e) => {
          const link = (e.target as HTMLElement).closest?.('a[href^="#"]') as HTMLAnchorElement | null
          if (!link) return
          const seccion = document.querySelector(link.getAttribute('href')!) as HTMLElement | null
          if (!seccion) return
          e.preventDefault()
          history.replaceState(null, '', link.getAttribute('href'))
          // Un respiro para que el menú de celular se cierre (libera el scroll) antes de movernos.
          setTimeout(() => {
            const y = Math.max(0, destino(seccion))
            if (lenis) lenis.scrollTo(y, { duration: 1.2 })
            else window.scrollTo({ top: y, behavior: menosMovimiento ? 'auto' : 'smooth' })
          }, 60)
        },
        true,
      )
    </script>
  </body>
</html>
