{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // La API se publica en api.mergge.com.ar. Wrangler crea el registro DNS solo
  // (la zona mergge.com.ar tiene que estar en esta cuenta de Cloudflare).
  "routes": [
    { "pattern": "api.mergge.com.ar", "custom_domain": true, "zone_name": "mergge.com.ar" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mergge-leads",
      "database_id": "f632abbf-d62a-48b9-aeeb-f85dacbbd645",
      "migrations_dir": "migrations"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}